{
  "name": "senda-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace @senda/frontend",
    "build:frontend": "npm run build --workspace @senda/frontend",
    "db:up": "npm run db:up --workspace @senda/database",
    "db:down": "npm run db:down --workspace @senda/database",
    "db:migrate:dev": "npm run db:migrate:dev --workspace @senda/database",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @senda/database",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "npm@11.4.2"
}
