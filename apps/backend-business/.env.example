# Copy to ".env" for local development. Never commit real secrets.

NODE_ENV="development"
HOST="0.0.0.0"
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL="info"

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS="http://localhost:3000"
# Set to "true" only when running behind a trusted reverse proxy / load balancer.
TRUST_PROXY="false"

# Requests per window per client IP.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

# Shared PostgreSQL (see packages/database).
DATABASE_URL="postgresql://senda:senda@localhost:5432/senda?schema=public"

# Stellar / Soroban. Leave the RPC URLs empty until the integration ships.
STELLAR_NETWORK="testnet"
STELLAR_HORIZON_URL=""
SOROBAN_RPC_URL=""
# Contract address (C...) of contracts/business-payments once deployed.
BUSINESS_PAYMENTS_CONTRACT_ID=""
